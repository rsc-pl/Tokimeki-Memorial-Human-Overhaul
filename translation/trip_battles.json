  {
   "file": "CDROM/EXEDIR/RPG_BAT.EXN",
   "offset": "0x29638",
   "original": "戦闘に勝った！！",
   "text": "Battle won!!"
  },
  {
   "file": "CDROM/EXEDIR/RPG_BAT.EXN",
   "offset": "0x2964C",
   "original": "経験値　：２３６０ＥＸＰ",
   "text": "EXP  : 2360 EXP"
  },
  {
   "file": "CDROM/EXEDIR/RPG_BAT.EXN",
   "offset": "0x29668",
   "original": "お金　　：３６００ゴールド",
   "text": "Money: 3600 Gold"
  },
  {
   "file": "CDROM/EXEDIR/RPG_BAT.EXN",
   "offset": "0x29684",
   "original": "「誰だっ！",
   "text": "「Who?!"
  },
  {
   "file": "CDROM/EXEDIR/RPG_BAT.EXN",
   "offset": "0x29690",
   "original": "（どこからともなく声が聞こえてきた）",
   "text": "(A voice came from nowhere.)"
  },
  {
   "file": "CDROM/EXEDIR/RPG_BAT.EXN",
   "offset": "0x296B8",
   "original": "「もう超眼力は見切ったぜ！",
   "text": "「Glare won't work now!"
  },
  {
   "file": "CDROM/EXEDIR/RPG_BAT.EXN",
   "offset": "0x296D4",
   "original": "番長！　負ける訳にはいかない！！",
   "text": "Boss! I can't lose this!!"
  },
  {
   "file": "CDROM/EXEDIR/RPG_BAT.EXN",
   "offset": "0x296F8",
   "original": "ミスリル学ラン",
   "text": "Mithril Coat"
  },
  {
