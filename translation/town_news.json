  "dialogue": [
    {
      "file": "SLPM_86.053",
      "base": "0x80040800",
      "lines": [
        {
          "offset": "0x75C20",
          "original": "これが、こんど創刊された\n情報誌か。\nそうそう、カレンダーで\n自分のバイオリズムが、\n確認できるんだった。）",
          "text": "So this is the new\ninfo magazine.\nOh yeah, the calendar\nlets me check\nmy biorhythm.)"
        },
        {
          "offset": "0x75C8C",
          "original": "きらめき中央公園か。）",
          "text": "Kirameki Park, huh.)"
        },
        {
          "offset": "0x75CA4",
          "original": "美術館ができたのか。）",
          "text": "An art museum opened.)"
        },
        {
          "offset": "0x75CBC",
          "original": "水族館があるのか。\nそういえば、\nシステムファイルを作ると\nアルバムのデータ管理が\n楽になるらしいぞ）",
          "text": "An aquarium, huh.\nCome to think of it,\na system file makes\nalbum data much easier\nto manage.)"
        },
        {
          "offset": "0x75D20",
          "original": "スタジアムができたのか。\nん、フリーモードのアイコンは\nＬ２を押してつかめるのか。）",
          "text": "A stadium opened.\nPress L2 to grab an icon\nin Free Mode.)"
        },
        {
          "offset": "0x75D74",
          "original": "植物園かあ。そういえば詩織が\n夜に羊を数える癖があったな。\nどこかで聞けたんだけど。）",
          "text": "Botanical gardens...\nShiori counts sheep nightly.\nWhere did I hear that?)"
        },
        {
          "offset": "0x75DCC",
          "original": "ボーリングかあ。）",
          "text": "Bowling, huh.)"
        },
        {
          "offset": "0x75DE0",
          "original": "プラネタリウムかあ。）\n",
          "text": "Planetarium, huh.)\n"
        },
        {
          "offset": "0x75DF8",
          "original": "カラオケかあ。）",
          "text": "Karaoke, huh.)"
        },
        {
          "offset": "0x75E0C",
          "original": "情報誌を見ながら、コナミ\nコマンドを入力すると…。\n↑↑↓↓←→←→×○）",
          "text": "While reading the magazine,\nenter the Konami Code...\nU U D D L R L R X O)"
        },
        {
          "offset": "0x75E58",
          "original": "ふーん。\nガーギー展かあ。）",
          "text": "Hmm.\nA Gargy exhibit, huh.)"
        },
        {
          "offset": "0x75E74",
          "original": "この情報誌も、\nこれで最後か…。）",
          "text": "This magazine ends\nwith this issue...)"
        },
        {
          "offset": "0x75E98",
          "original": "………。）",
          "text": "...)"
        }
      ]
    }
  ]
